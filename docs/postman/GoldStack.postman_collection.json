{
  "info": {
    "name": "GoldStack API",
    "description": "Every public and protected route of the GoldStack API. Run Sign up or Log in first: they save the JWT. Start the stack with docker compose up --build -d, then use http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "sipId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Creates the account, gives 10,000 bonus coins and returns a JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"riya@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"fullName\": \"Riya\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"riya@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ]
        },
